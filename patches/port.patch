+// SPDX-License-Identifier: GPL-3.0-only
+// Match the player's screen-edge clamp to the native wide viewport. The
+// game's terrain/actor collisions run before this screen-only constraint.
+#include "dino.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+namespace cps2recomp {
+bool DinoWidePlayerBounds(bool local, int &left, int &right);
+namespace {
+template<bool Local>
+bool WidePlayerX(M68K &c) {
+    const uint32_t player=c.a[6]&0xFFFFFF;
+    if (player!=dino::Player(0) && player!=dino::Player(1) && player!=dino::Player(2)) return false;
+    if (!FeatureOn("widescreen")) return false;
+    static const bool off=std::getenv("DINO_WIDE_MOVEMENT_OFF")!=nullptr;
+    if (off) return false;
+    int left=0, right=0;
+    if (!DinoWidePlayerBounds(Local,left,right)) return false;
+    // Episode 3's final camera segment is X7FF0 (ROM021D0A), so a valid
+    // player can cross 8000. Interpret the 16-bit coordinate near this
+    // viewport, rather than treating every world coordinate as signed.
+    const int reference=left+(right-left)/2;
+    const int x=reference+static_cast<int16_t>(Ram16(player+dino::kX)-reference);
+    const int constrained=std::clamp(x,left,right);
+    if (constrained!=x) SetRam16(player+dino::kX,static_cast<uint16_t>(constrained));
+    // Original SUB.W adjusts only the integer word. Keep subpixel position,
+    // momentum, the camera, scripted wave gates and all Y constraints intact.
+    // The continuation overwrites D0 and arithmetic flags with its Y work.
+    c.pc=Local ? 0x005020 : 0x004FEE;
+    c.cycles+=(Local ? 46 : 58)+(x>=right ? 14 : 0);
+    static const bool check=std::getenv("DINO_WIDE_MOVEMENT_CHECK")!=nullptr;
+    static unsigned reports=0;
+    const int camera=Local ? 0 : Ram16(0xFF8744);
+    if (check && reports<24 && (x<camera+16 || x>camera+368)) {
+        ++reports;
+        const auto &machine=static_cast<Machine &>(c.bus);
+        std::fprintf(stderr,"dino wide movement: frame %llu player %06X local %d x %d result %d bounds %d..%d camera %d\n",
+            static_cast<unsigned long long>(machine.frame),player,Local,x,constrained,left,right,camera);
+    }
+    return true;
+}
+} // namespace
+
+void RegisterDinoMovementWide() {
+    // 018E98 reaches this after 012CAC's floor/wall/object collision work.
+    // Replace just X; resume at the original normal/local Y clamp.
+    AddHook(0x004FD6,"WidePlayerWorldX",WidePlayerX<false>);
+    AddHook(0x00500C,"WidePlayerLocalX",WidePlayerX<true>);
+}
+} // namespace cps2recomp
