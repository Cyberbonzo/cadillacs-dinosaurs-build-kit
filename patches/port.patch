+    AddHook(0x0124F6,"InfiniteHealth0124F6",KeepHealth<3,0x012502>);
+    AddHook(0x01256A,"InfiniteHealth01256A",KeepHealth<3,0x01257E>);
+    AddHook(0x01262E,"InfiniteHealth01262E",KeepHealth<3,0x01263A>);
+    AddHook(0x0126D2,"InfiniteHealth0126D2",KeepHealth<3,0x0126EC>);
