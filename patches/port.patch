+// SPDX-License-Identifier: GPL-3.0-only
+// Additional native-size scenery bays for the escape scene. The source
+// paints only its 384-column viewport; adjacent VRAM still contains the lab.
+#include "dino.h"
+
+namespace cps2recomp {
+void DinoEndingComicAfterFrame(Machine &);
+namespace {
+int EndingPhase() {
+    if (Ram8(0xFF84D0) != 0x1C) return -1;
+    // 0A6ABA starts object 0148. Its handler 08AA38 dispatches byte +5;
+    // this is the running script state, independent of frame rate or time.
+    for (unsigned n=0; n<24; ++n) {
+        const uint32_t object=0xFFB6F4+n*0xC0;
+        if (Ram8(object) && Ram8(object+4)==2 && Ram16(object+0x20)==0x148)
+            return Ram8(object+5);
+    }
+    return -1;
+}
+void MapTile(Machine &machine, int which, int column, int row,
+             uint16_t &code, uint16_t &attributes) {
+    column &= 63;
+    const uint32_t base=(static_cast<uint32_t>(machine.cpsA[which+1])*256)&0x3C000;
+    const uint32_t index=which==1 ? (row&15)+(column<<4)+((row&48)<<6)
+                                 : (row&7)+(column<<3)+((row&56)<<6);
+    const uint8_t *p=&machine.videoRam[base+index*4];
+    code=static_cast<uint16_t>((p[0]<<8)|p[1]);
+    attributes=static_cast<uint16_t>((p[2]<<8)|p[3]);
+}
+} // namespace
+
+bool DinoEndingTile(Machine &machine, int which, int column, int row, int at,
+                    uint16_t &code, uint16_t &attributes) {
+    if (which==0) { code=0x001F; attributes=0; return true; }
+    const int phase=EndingPhase();
+    if (phase>=8 && phase<=0x12) {
+        // 08ACE8 replaces the outdoor foreground/background only within
+        // the original viewport. Add another 64px bay of their sky, cliff
+        // and floor at each side, using tiles from the same row. Objects
+        // are rendered once at their original position, never duplicated.
+        const int offset=which==1 ? 8 : 4;
+        MapTile(machine,which,column+(at<64 ? offset : -offset),row,code,attributes);
+        return true;
+    }
+    if (phase>=0x14 && phase<=0x18) {
+        // The isolated comic card is composed after rendering. Do not
+        // expose the previous lab's unused tile columns around it.
+        code=which==1 ? 0x5800 : 0x1C00; attributes=0; return true;
+    }
+    return false;
+}
+
+void DinoEndingAfterFrame(Machine &machine) {
+    const int phase=EndingPhase();
+    if (phase==0x14 || phase==0x16) DinoEndingComicAfterFrame(machine);
+}
+} // namespace cps2recomp
