+// SPDX-License-Identifier: GPL-3.0-only
+#include "dino.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace cps2recomp {
+namespace {
+template<unsigned AddressRegister, uint32_t Resume, unsigned Cycles=26>
+bool KeepHealth(M68K &c) {
+    const uint32_t player=c.a[AddressRegister]&0xFFFFFF;
+    if (player!=dino::Player(0) && player!=dino::Player(1) && player!=dino::Player(2)) return false;
+    const unsigned health=Ram16(player+0x6C);
+    if (!Ram8(player) || health==0 || health>dino::kHealthFull) return false;
+    const bool keep=FeatureOn("infinite_health");
+    static const bool check=std::getenv("DINO_HEALTH_CHECK")!=nullptr;
+    static unsigned reports=0;
+    if (check && reports++<300) {
+        const auto &machine=static_cast<Machine &>(c.bus);
+        std::fprintf(stderr,"dino health: frame %llu pc %06X player %06X hp %u d0 %u d1 %u keep %u\n",
+            static_cast<unsigned long long>(machine.frame),c.pc,player,health,c.d[0]&0xFFFF,c.d[1]&0xFFFF,keep);
+    }
+    if (!keep) return false;
+    // Stop the health subtraction before its lethal branch, retaining the
+    // original hit reaction, knockback, weapon drops and special-move logic.
+    // The caller's damage registers still serve its later effects/scoring.
+    c.Sub(health,0,1,false,false);
+    c.pc=Resume;
+    c.cycles+=Cycles;
+    return true;
+}
+
+template<uint32_t Resume>
+bool KeepAmmunition(M68K &c) {
+    const uint32_t weapon=c.a[6]&0xFFFFFF;
+    if (weapon<0xFF0000 || weapon>0xFFFF4F) return false;
+    const uint32_t player=0xFF0000|Ram16(weapon+0x70);
+    if (player!=dino::Player(0) && player!=dino::Player(1) && player!=dino::Player(2)) return false;
+    if (!Ram8(player) || Ram16(player+0xB4)!=(weapon&0xFFFF) ||
+        Ram16(player+0xB6)!=Ram16(weapon+0xA0)) return false;
+    const unsigned ammo=Ram16(weapon+0x6C);
+    const bool keep=FeatureOn("infinite_ammo") && ammo>0;
+    static const bool check=std::getenv("DINO_AMMO_CHECK")!=nullptr;
+    static unsigned reports=0;
+    if (check && reports++<300) {
+        const auto &machine=static_cast<Machine &>(c.bus);
+        std::fprintf(stderr,"dino ammo: frame %llu pc %06X player %06X weapon %06X type %04X ammo %u keep %u\n",
+            static_cast<unsigned long long>(machine.frame),c.pc,player,weapon,
+            Ram16(weapon+0xA0),ammo,keep);
+    }
+    if (!keep) return false;
+    // Replace SUBQ.W #1,6C(A6) with subtract-zero, then take the original
+    // nonempty branch. This also preserves a gun with its last round; it
+    // never creates ammunition or changes another object's health/durability.
+    c.Sub(ammo,0,1,false,false);
+    c.pc=Resume;
+    c.cycles+=26; // original memory SUBQ (16) and taken BNE (10)
+    return true;
+}
+} // namespace
+
+void RegisterDinoCheats() {
+    TheGame().features.push_back({"infinite_ammo","Cheats","Infinite Ammo",
+        "Firing does not consume ammunition for any player.",0,{"No","Yes"}});
+    // Native collision damage, special-move health costs, and grab damage.
+    AddHook(0x010788,"InfiniteHealth010788",KeepHealth<3,0x010796>);
+    AddHook(0x010A5E,"InfiniteHealth010A5E",KeepHealth<3,0x010A6A>);
+    AddHook(0x010B1E,"InfiniteHealth010B1E",KeepHealth<2,0x010B2C>);
