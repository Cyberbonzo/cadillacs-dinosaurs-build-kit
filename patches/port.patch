+void M68K::NativeCheck(unsigned reg, int16_t bound, uint32_t next, unsigned operandCycles) {
+    pc = next;
+    const int16_t value = static_cast<int16_t>(d[reg]);
+    cycles += 10 + operandCycles;
+    if (value < 0 || value > bound) {
+        flagN = value < 0;
+        Exception(6, pc, -1);
+        cycles += 30;
+    }
+}
+
+void M68K::NativeDivide(unsigned reg, uint16_t source, bool isSigned, uint32_t next, unsigned operandCycles) {
+    pc = next;
+    if (source == 0) {
+        Exception(5, pc, -1);
+        flagN = flagZ = flagV = flagC = false;
+        cycles += 42;
+        return;
+    }
+    flagZ = flagC = false;
+    if (isSigned) {
+        const int32_t dividend = static_cast<int32_t>(d[reg]);
+        const int16_t divisor = static_cast<int16_t>(source);
+        const int64_t quotient = static_cast<int64_t>(dividend) / divisor;
+        const int64_t remainder = static_cast<int64_t>(dividend) % divisor;
+        const uint32_t magnitude = static_cast<uint32_t>(dividend < 0 ? -static_cast<int64_t>(dividend) : dividend);
+        const uint32_t limit = static_cast<uint32_t>(std::abs(static_cast<int32_t>(divisor))) << 16;
+        if (magnitude >= limit && divisor != -0x8000) {
+            flagN = flagV = true;
+        } else {
+            flagZ = quotient == 0;
+            flagV = quotient != static_cast<int16_t>(quotient);
+            if (flagV) {
+                flagN = true;
+            } else {
+                d[reg] = static_cast<uint16_t>(quotient) | (static_cast<uint32_t>(static_cast<uint16_t>(remainder)) << 16);
+                flagN = quotient & 0x8000;
+            }
+        }
+        cycles += 158;
+    } else {
+        const uint32_t quotient = d[reg] / source, remainder = d[reg] % source;
+        flagZ = quotient == 0;
+        flagV = quotient > 0xFFFF;
+        if (flagV) {
+            flagN = true;
+        } else {
+            d[reg] = quotient | (remainder << 16);
+            flagN = quotient & 0x8000;
+        }
+        cycles += 140;
+    }
+    cycles += operandCycles;
+}
