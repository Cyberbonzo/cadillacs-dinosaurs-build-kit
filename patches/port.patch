+// SPDX-License-Identifier: GPL-3.0-only
+// The original sprite assembler discards individual blocks outside hardware
+// X64..448, before the renderer ever receives them. Extend only that visual
+// culling rectangle; actor simulation, activation and collision stay intact.
+#include "dino.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace cps2recomp {
+namespace {
+template<uint32_t Emit>
+bool WideObjectPiece(M68K &c) {
+    auto &machine=static_cast<Machine &>(c.bus);
+    const auto &wide=machine.video.wide;
+    // The stage renderer installs an object-offset callback. Special cards
+    // do not: their deliberately hidden objects must remain hidden.
+    if (!wide.side || !wide.object || !FeatureOn("widescreen")) return false;
+    static const bool off=std::getenv("DINO_WIDE_OBJECTS_OFF")!=nullptr;
+    if (off) return false;
+    const int x=static_cast<int16_t>(c.d[0]);
+    const uint16_t attributes=static_cast<uint16_t>(c.d[3]);
+    const int width=(((attributes>>8)&15)+1)*16;
+    // Preserve the original code path for every piece it already accepted.
+    // Its inclusive edge comparison also admits completely clipped pieces.
+    if (x<=0x1C0 && (x>0x40 || x+width>=0x40)) return false;
+    const int shift=wide.side-Video::kFirstColumn-wide.object(0,attributes,0);
+    if (x+shift>=machine.video.Width() || x+width+shift<=0) return false;
+
+    static const bool check=std::getenv("DINO_WIDE_OBJECTS_CHECK")!=nullptr;
+    static unsigned reported=0;
+    if (check && reported++<16) {
+        std::fprintf(stderr,"dino wide object: frame %llu pc %06X actor %06X rawX %d width %d screenX %d emit %06X\n",
+            static_cast<unsigned long long>(machine.frame),c.pc,c.a[0]&0xFFFFFF,
+            x,width,x+shift,Emit);
+    }
+    // Both branches resume at the existing native writer. Its subsequent
+    // MOVE/ADD overwrite the flags and scratch registers used by culling;
+    // the block's tile, position, palette, flip and ordering remain original.
+    c.pc=Emit;
+    // Account for the clip decision replaced here. Additional sprite writes
+    // retain their native instruction timing in the existing continuation.
+    c.cycles+=x>0x1C0 ? 18 : 114;
+    return true;
+}
+} // namespace
+
+void RegisterDinoObjectsWide() {
+    // Fixed-palette, per-block-palette, flipped, low-height and direct-data
+    // assemblers. Each hook starts at CMP.W #$1C0,D0, after D0/D3 are ready.
+    AddHook(0x014306,"WideObject14306",WideObjectPiece<0x014338>);
+    AddHook(0x014358,"WideObject14358",WideObjectPiece<0x01438A>);
+    AddHook(0x0143FE,"WideObject143FE",WideObjectPiece<0x014430>);
+    AddHook(0x014450,"WideObject14450",WideObjectPiece<0x014482>);
+    AddHook(0x0144D6,"WideObject144D6",WideObjectPiece<0x014506>);
+    AddHook(0x01452C,"WideObject1452C",WideObjectPiece<0x01455C>);
+    AddHook(0x014592,"WideObject14592",WideObjectPiece<0x0145C2>);
+    AddHook(0x0145FE,"WideObject145FE",WideObjectPiece<0x01462E>);
+    AddHook(0x014696,"WideObject14696",WideObjectPiece<0x0146C6>);
+    AddHook(0x0146EC,"WideObject146EC",WideObjectPiece<0x01471C>);
+    AddHook(0x014752,"WideObject14752",WideObjectPiece<0x014782>);
+    AddHook(0x0147BE,"WideObject147BE",WideObjectPiece<0x0147EE>);
+    AddHook(0x01484A,"WideObject1484A",WideObjectPiece<0x01487A>);
+    AddHook(0x0148A8,"WideObject148A8",WideObjectPiece<0x0148D8>);
+    AddHook(0x014906,"WideObject14906",WideObjectPiece<0x014936>);
