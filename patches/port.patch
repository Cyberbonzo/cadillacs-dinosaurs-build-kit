@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Dino's opening: retain the authored art at its original pixel size.
+#include "dino.h"
+
+#include <vector>
+
+namespace cps2recomp {
+namespace {
+uint16_t OpeningWord(uint32_t at) {
+    const uint8_t *p = Program(at);
+    return static_cast<uint16_t>((p[0] << 8) | p[1]);
+}
+
+bool ForestIsPainted(const Machine &machine) {
+    // 09BF50's script event index, incremented before dispatch. Event 8
+    // calls 09C29C, painting the forest. Event 32 fades and clears it.
+    const unsigned event = Ram16(0xFF0FFE);
+    const uint8_t *p = &machine.videoRam[0xF000];
+    return event >= 8 && event <= 32 &&
+           p[0] == 0x58 && p[1] == 0x0F && p[2] == 0x01 && p[3] == 0x82;
+}
+
+void EmptyOpeningTile(int which, uint16_t &code, uint16_t &attributes) {
+    // The exact clear tiles written by 000B52/000B6C/000B88.
+    code = which == 0 ? 0x20 : which == 1 ? 0x5800 : 0x1C00;
+    attributes = which == 0 ? 6 : 0;
+}
+} // namespace
+
+bool DinoOpeningTile(Machine &machine, int which, int column, int row, int,
+                     uint16_t &code, uint16_t &attributes) {
+    EmptyOpeningTile(which, code, attributes);
+    // The narrative text and CAPCOM card have no authored side scenery.
+    // In particular their old scroll maps must not expose a prior demo.
+    if (which == 0 || !ForestIsPainted(machine)) {
+        return true;
+    }
+    uint32_t tile = 0;
+    if (which == 1 && row >= 48) {
+        // 09C29C -> 0204CA: four 256px chunks cover the complete 1024px
+        // scroll-2 map. All 1024 entries match the natural opening dump.
+        static constexpr unsigned chunks[4] = {3, 4, 3, 3};
+        const unsigned cell = static_cast<unsigned>((column & 14) * 4 + ((row & 14) >> 1));
+        const unsigned meta = OpeningWord(0x145DC8 + chunks[column >> 4] * 128 + cell * 2);
+        tile = 0x175378 + meta * 16 + static_cast<unsigned>((column & 1) * 2 + (row & 1)) * 4;
+    } else if (which == 2 && row >= 56) {
+        // 09C308 -> 020592 paints chunk 72 three times. Continue that
+        // explicit 256px repeating tree pattern at the newly exposed edge.
+        tile = 0x177288 + 0x72 * 256 + static_cast<unsigned>((column & 7) * 8 + (row & 7)) * 4;
+    }
+    if (tile) {
+        code = OpeningWord(tile);
+        attributes = OpeningWord(tile + 2);
+    }
+    return true;
+}
+
+void DinoOpeningAfterFrame(Machine &machine) {
+    if (!ForestIsPainted(machine) || machine.PictureWidth() != 512) {
+        return;
+    }
+    // The source movie masks the forest to y=40..183. Replace its matte
+    // with additional 1:1 tree/foliage bands from that same scene. This is
+    // a deliberate extension using existing art, not recovered hidden art.
+    // Only the two forest planes move during this extra render; captions
+    // and characters stay at their original coordinates and keep their
+    // true transparent pixels. No colour-keying or pixel interpolation.
+    const uint16_t scroll2Y = machine.cpsA[9], scroll3Y = machine.cpsA[11];
+    const unsigned layerMask = machine.video.layerMask;
+    // At first the same matte covers the entire movie and opens vertically.
+    // Keeping that aperture in the centre while extending only its border
+    // produces black rectangles surrounded by visible forest. Convert the
+    // authored reveal to one fade of the whole 512-column composition.
+    // Read exact mask tiles, not the displayed colours (which also fade).
+    unsigned covered = 0, cells = 0;
+    const uint32_t map = (static_cast<uint32_t>(machine.cpsA[1]) * 256) & 0x3C000;
+    for (int y = 40; y < 184; y += 8) {
+        const unsigned row = ((machine.cpsA[7] + Video::kFirstLine + y) & 511) >> 3;
+        for (int x = 0; x < 384; x += 8) {
+            const unsigned column = ((machine.cpsA[6] + Video::kFirstColumn + x) & 511) >> 3;
+            const unsigned index = (row & 31) + (column << 5) + ((row & 32) << 6);
+            const uint8_t *p = &machine.videoRam[map + index * 4];
+            covered += p[0] == 0 && p[1] == 0x18 && p[2] == 0 && p[3] == 0;
+            ++cells;
+        }
+    }
+    // Scroll 1 supplies the movie's opaque matte with exact tile 0018.
+    // Remove only those authored mask tiles for this composition; the
+    // caption glyphs remain untouched, including their real transparency.
+    std::vector<uint32_t> matte;
+    for (uint32_t index = 0; index < 4096; ++index) {
+        const uint32_t at = map + index * 4;
+        if (machine.videoRam[at] == 0 && machine.videoRam[at + 1] == 0x18 &&
+            machine.videoRam[at + 2] == 0 && machine.videoRam[at + 3] == 0) {
+            matte.push_back(at);
+            machine.videoRam[at + 1] = 0x1F;
+        }
+    }
+    uint32_t *picture = machine.Picture();
+    for (int y = 0; y < Video::kHeight; ++y) {
+        const bool centre = y >= 40 && y < 184;
+        // Stable movie frames retain their original central pixels exactly.
+        if (centre && !covered) continue;
+        const int delta = centre ? 0 : y < 40 ? 64 : -64;
+        // The movie's actor list includes unused fragments under the matte.
+        // Keep its actors in the original movie, not in the new forest bands.
+        machine.video.layerMask = centre ? layerMask : layerMask & ~1u;
+        machine.cpsA[9] = static_cast<uint16_t>(scroll2Y + delta);
+        machine.cpsA[11] = static_cast<uint16_t>(scroll3Y + delta);
+        machine.video.RenderLine(y, picture + y * machine.PictureWidth());
+    }
+    machine.cpsA[9] = scroll2Y;
+    machine.cpsA[11] = scroll3Y;
+    machine.video.layerMask = layerMask;
+    for (uint32_t at : matte) machine.videoRam[at + 1] = 0x18;
+    if (covered) {
+        const unsigned visible = cells - covered;
+        for (int i = 0; i < machine.PictureWidth() * Video::kHeight; ++i) {
+            const uint32_t pixel = picture[i];
+            uint32_t faded = pixel & 0xFF000000u;
+            for (unsigned shift = 0; shift < 24; shift += 8)
+                faded |= ((((pixel >> shift) & 255) * visible + cells / 2) / cells) << shift;
+            picture[i] = faded;
+        }
+    }
+}
+} // namespace cps2recomp
--- a/games/dino/src/special_wide.cpp
+++ b/games/dino/src/special_wide.cpp
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Native 512-column layouts for dino (World 930201).
+#include "dino.h"
+#include <algorithm>
+#include <array>
+namespace cps2recomp {
+using namespace dino;
+// Proposal only. Existing Ram8/Ram32 read dino RAM in big-endian form.
+// Scheduler evidence: ROM00083C..00096E; 16slots atFF0052, each16bytes.
+// Main task can migrate between slots1and2. Never assume a fixed slot.
+// top-4 andtop-8 are active stack returns, not arbitrary scans of stale RAM.
+enum class DinoScene { Boot, Title, Profiles, Scores, Story, Opening, Demo,
+                       Selection, Transition, Continue, GameOver, Ending, Play };
+DinoScene ReadDinoScene() {
+    for (unsigned slot=0; slot<16; ++slot) {
+        const uint32_t task=0xFF0052+slot*16;
+        const uint8_t status=Ram8(task);
+        if (status==0) continue; // removed/inactive task: stale stack ignored
+        const uint32_t sp=Ram32(task+8), top=Ram32(task+12);
+        if (sp<0xFF0200 || top>=0xFF8000 || (sp&1) || (top&1) ||
+            sp>=top || top-sp>0x400 || top-sp<8) continue;
+        const uint32_t caller=Ram32(top-4);
+        if (caller==0x097A06) return DinoScene::Title; // paid/freeplay credit title
+        if (caller!=0x097C66) continue; // not the main attract loop's active stack
+        switch (Ram32(top-8)) {
+        case 0x097CCE: case 0x097CD2: case 0x097D22: case 0x097D26:
+        case 0x097DA4: case 0x097DAE: return DinoScene::Title;
+        case 0x097DAA: return DinoScene::Profiles;
+        case 0x097CFC: case 0x097D34: case 0x097DB8: case 0x097D58:
+        case 0x097CBA: return DinoScene::Scores;
+        case 0x097CE6: return DinoScene::Story;
+        case 0x097D3A: return DinoScene::Opening;
+        case 0x097CD6: case 0x097D2A: return DinoScene::Demo;
+        }
+    }
+    switch (Ram8(0xFF84D0)) {
+    case 0x04: return DinoScene::Selection;
+    case 0x08: return DinoScene::Transition;
+    case 0x0C: return DinoScene::Play;
+    case 0x10: return Ram8(0xFF84D1)<4 ? DinoScene::Continue : DinoScene::GameOver;
+    case 0x14: case 0x18: return DinoScene::GameOver;
+    case 0x1C: return DinoScene::Ending;
+    default: return DinoScene::Boot;
+    }
+}
+bool DinoSpecialScene() {
+    const auto scene = ReadDinoScene();
+    return scene != DinoScene::Play && scene != DinoScene::Demo;
+}
+bool DinoAttractDemo() { return ReadDinoScene() == DinoScene::Demo; }
+
+
+bool DinoOpeningTile(Machine &, int, int, int, int, uint16_t &, uint16_t &);
+void DinoOpeningAfterFrame(Machine &);
+void DinoStoryAfterFrame(Machine &);
+bool DinoEndingTile(Machine &, int, int, int, int, uint16_t &, uint16_t &);
+void DinoEndingAfterFrame(Machine &);
+namespace {
+Machine *g_machine = nullptr;
+DinoScene g_scene = DinoScene::Boot;
+bool SideTile(int which, int column, int row, int at, uint16_t &code, uint16_t &attr) {
+    if (g_machine && g_scene==DinoScene::Opening)
+        return DinoOpeningTile(*g_machine,which,column,row,at,code,attr);
+    if (g_machine && g_scene==DinoScene::Ending)
+        return DinoEndingTile(*g_machine,which,column,row,at,code,attr);
+    if (which == 0) { code = 0x001F; attr = 0; return true; }
+    return false;
+}
+}
+void DinoSpecialWide(Machine &machine) {
+    auto &wide = machine.video.wide;
+    wide = {};
+    g_machine = &machine;
+    g_scene = ReadDinoScene();
+    if (FeatureOn("widescreen")) {
+        wide.side = Video::kWideSide;
+        wide.tile = SideTile;
+    }
+}
+void DinoSpecialAfterFrame(Machine &machine) {
+    if (!FeatureOn("widescreen") || machine.PictureWidth()!=512) return;
+    const auto scene=ReadDinoScene();
+    if (g_scene == DinoScene::Opening && scene == DinoScene::Title) {
+        // The opening clears its planes and returns to the title within a
+        // raster frame. Finish that frame with the new scene's maps and
+        // callback, rather than retaining a fragment of the forest extension.
+        DinoSpecialWide(machine);
+        for (int y = 0; y < Video::kHeight; ++y)
+            machine.video.RenderLine(y, machine.Picture() + y * 512);
+    }
+    // Scene initialization sometimes paints a solid clear/flash card only
+    // across the original viewport. Its unused map columns still contain
+    // the previous scene (or black). Extend that exact uniform card to the
+    // added sides. No pixels of an illustrated/text scene are replaced.
+    if ((scene != DinoScene::Play && scene != DinoScene::Demo) || Ram8(kStep) != 0x0C) {
+        auto *pixels = machine.Picture();
+        const uint32_t colour = pixels[Video::kWideSide];
+        bool uniform = true;
+        for (int y = 0; y < Video::kHeight && uniform; ++y) {
+            for (int x = Video::kWideSide; x < Video::kWideSide + Video::kWidth; ++x) {
+                if (pixels[y * 512 + x] != colour) { uniform = false; break; }
+            }
+        }
+        if (uniform) {
+            for (int y = 0; y < Video::kHeight; ++y) {
+                std::fill_n(pixels + y * 512, Video::kWideSide, colour);
+                std::fill_n(pixels + y * 512 + Video::kWideSide + Video::kWidth, Video::kWideSide, colour);
+            }
+        }
+    }
+    if (scene==DinoScene::Ending) { DinoEndingAfterFrame(machine); return; }
+    if (scene==DinoScene::Story) { DinoStoryAfterFrame(machine); return; }
+    if (scene==DinoScene::Opening) { DinoOpeningAfterFrame(machine); return; }
+    if (scene==DinoScene::Title) {
+        auto *pixels=machine.Picture();
+        const uint32_t backdrop=pixels[256];
+        for (int y=0;y<224;++y) {
+            std::fill_n(pixels+y*512,64,backdrop);
+            std::fill_n(pixels+y*512+448,64,backdrop);
+        }
+        return;
+    }
+    if (scene==DinoScene::Selection || scene==DinoScene::Continue || scene==DinoScene::GameOver) {
+        std::array<uint32_t,384*224> original;
+        std::array<uint32_t,512> background;
+        auto *pixels=machine.Picture();
+        for (int y=0;y<224;++y) std::copy_n(pixels+y*512+64,384,original.data()+y*384);
+        const unsigned mask=machine.video.layerMask;
+        machine.video.layerMask=8;
+        for (int y=0;y<224;++y) {
+            machine.video.RenderLine(y,background.data());
+            auto *out=pixels+y*512;
+            std::copy_n(background.data()+64,64,background.data());
+            if (scene==DinoScene::Selection) {
+                // The three original selection cards keep all 128 columns;
+                // spread them across the wider landscape beneath the cast.
+                if (y>=144) {
+                    std::copy_n(background.data(),512,out);
+                    const auto *src=original.data()+y*384;
+                    for (int n=0;n<3;++n) std::copy_n(src+n*128,128,out+n*192);
+                } else {
+                    std::copy_n(background.data(),64,out);
+                    std::copy_n(background.data()+448,64,out+448);
+                }
+            } else {
+                // Extend the smoke/background pattern using two further
+                // native-size bays, without exposing the unused tile map's
+                // diagnostic numbers or duplicating character sprites.
+                std::copy_n(background.data()+64,64,out);
+                std::copy_n(background.data()+384,64,out+448);
+            }
+        }
+        machine.video.layerMask=mask;
+        return;
+    }
+    if (scene!=DinoScene::Profiles) return;
+    // The two original 192px panels become two 256px panels. All original
+    // art and lettering stays at its native pixel scale; the stripe design
+    // spans its wider panel and unused off-screen sprites are not exposed.
+    std::array<uint32_t,384*224> original;
+    auto *pixels=machine.Picture();
+    for (int y=0;y<224;++y)
+        std::copy_n(pixels+y*512+64,384,original.data()+y*384);
+    for (int y=0;y<224;++y) {
+        auto *out=pixels+y*512;
+        const auto *src=original.data()+y*384;
+        std::fill_n(out,256,src[0]);
+        std::fill_n(out+256,256,src[192]);
+        std::copy_n(src,192,out+32);
+        std::copy_n(src+192,192,out+288);
+    }
+}
+}
--- a/games/dino/src/story_wide.cpp
+++ b/games/dino/src/story_wide.cpp
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// The story uses isolated comic illustrations, not a hidden landscape.
+// Arrange the original illustration and caption as a wide comic card.
+#include "dino.h"
+
+#include <algorithm>
+#include <vector>
+
+namespace cps2recomp {
+namespace {
+uint32_t StoryCall() {
+    for (unsigned slot = 0; slot < 16; ++slot) {
+        const uint32_t task = 0xFF0052 + slot * 16;
+        if (!Ram8(task)) continue;
+        const uint32_t sp = Ram32(task + 8), top = Ram32(task + 12);
+        if (sp < 0xFF0200 || top >= 0xFF8000 || ((sp | top) & 1) ||
+            sp >= top || top - sp < 12 || top - sp > 0x400) continue;
+        if (Ram32(top - 4) == 0x097C66 && Ram32(top - 8) == 0x097CE6) {
+            return Ram32(top - 12);
+        }
+    }
+    return 0;
+}
+
+uint16_t CaptionTile(const Machine &machine, int x, int y) {
+    const int column = ((machine.cpsA[6] + Video::kFirstColumn + x) & 511) >> 3;
+    const int row = ((machine.cpsA[7] + Video::kFirstLine + y) & 511) >> 3;
+    const uint32_t base = (static_cast<uint32_t>(machine.cpsA[1]) * 256) & 0x3C000;
+    const uint32_t index = (row & 31) + (column << 5) + ((row & 32) << 6);
+    const uint8_t *p = &machine.videoRam[base + index * 4];
+    return static_cast<uint16_t>((p[0] << 8) | p[1]);
+}
+bool BlankCaption(uint16_t code) { return code == 0x1F || code == 0x20 || code == 0x680 || code == 0x690; }
+struct Glyph { int x, y; bool space; };
+
+std::vector<Glyph> Caption(const Machine &machine) {
+    std::vector<Glyph> glyphs;
+    for (int y = 0; y <= 208; y += 8) {
+        int first = 48, last = -1;
+        // Top and bottom together retain punctuation whose top tile is blank.
+        for (int col = 0; col < 48; ++col) {
+            if (!BlankCaption(CaptionTile(machine, col * 8, y)) ||
+                !BlankCaption(CaptionTile(machine, col * 8, y + 8))) {
+                first = std::min(first, col); last = col;
+            }
+        }
+        if (last < first) continue;
+        // y is the row before a glyph when only the second row has ink.
+        // Normal caption rows are found from the first nonblank top row.
+        bool topHasInk = false;
+        for (int col = first; col <= last; ++col)
+            topHasInk |= !BlankCaption(CaptionTile(machine, col * 8, y));
+        if (!topHasInk) continue;
+        if (!glyphs.empty()) glyphs.push_back({0, 0, true});
+        for (int col = first; col <= last; ++col) {
+            glyphs.push_back({col * 8, y,
+                BlankCaption(CaptionTile(machine, col * 8, y)) &&
+                BlankCaption(CaptionTile(machine, col * 8, y + 8))});
+        }
+        y += 8;
+    }
+    return glyphs;
+}
+
+void CopyRect(const std::vector<uint32_t> &source, uint32_t *out,
+              int sx, int sy, int width, int height, int dx, int dy) {
+    for (int y = 0; y < height; ++y) {
+        if (dy + y < 0 || dy + y >= 224 || sy + y < 0 || sy + y >= 224) continue;
+        const int lo = std::max(0, -dx), hi = std::min(width, 512 - dx);
+        if (hi > lo) std::copy_n(source.data() + (sy + y) * 512 + sx + lo,
+                                hi - lo, out + (dy + y) * 512 + dx + lo);
+    }
+}
+} // namespace
+
+static void ComicAfterFrame(Machine &machine, bool ending) {
+    const uint32_t call = ending ? 0 : StoryCall();
+    if (machine.PictureWidth() != 512 || (!ending && (call < 0x0988C0 || call >= 0x098B86))) return;
+    auto &video = machine.video;
+    const unsigned mask = video.layerMask;
+    std::vector<uint32_t> art(512 * 224), text(512 * 224);
+    video.layerMask = mask & ~2u;
+    for (int y = 0; y < 224; ++y) video.RenderLine(y, art.data() + y * 512);
+    video.layerMask = mask & 2u;
+    for (int y = 0; y < 224; ++y) video.RenderLine(y, text.data() + y * 512);
+    video.layerMask = 0;
+    uint32_t blank[512];
+    video.RenderLine(0, blank);
+    video.layerMask = mask;
+    uint32_t *out = machine.Picture();
+    std::fill_n(out, 512 * 224, blank[0]);
+
+    int textX = 296, textWidth = 200, fixedY = -1;
+    bool centreText = false;
+    if (ending) {
+        // Ending's city illustration: a distinct 256x128 original panel.
+        // The ending helper selects this card before calling us.
+        CopyRect(art, out, 112, 48, 256, 128, 16, 48);
+    } else if (call < 0x09895C) {
+        CopyRect(art, out, 128, 32, 256, 128, 16, 48);
+    } else if (call < 0x0989A6) {
+        CopyRect(art, out, 176, 64, 128, 96, 32, 64);
+        textX = 192; textWidth = 304;
+    } else if (call < 0x098A3E) {
+        CopyRect(art, out, 144, 32, 224, 128, 16, 48);
+        textX = 272; textWidth = 224;
+    } else if (call < 0x098AEE) {
+        // Until the slide finishes, the moving panel crosses the middle:
+        // keep it whole. Once settled the two 192px halves can spread apart.
+        if (call < 0x098ACA) {
+            CopyRect(art, out, 64, 0, 384, 168, 64, 0);
+        } else {
+            CopyRect(art, out, 64, 0, 192, 168, 0, 0);
+            CopyRect(art, out, 256, 0, 192, 168, 320, 0);
+        }
+        textX = 32; textWidth = 448; fixedY = 176;
+    } else {
+        CopyRect(art, out, 64, 0, 192, 224, 16, 0);
+        textX = 240; textWidth = 256;
+        if (call < 0x098B42) {
+            // The preceding text-only intertitle has no portrait yet.
+            textX = 32; textWidth = 448; centreText = true;
+        }
+    }
+
+    if (ending) {
+        // The credits begin while the city card is still present. Their
+        // 0120..015F font is 8px high, unlike the 16px dialogue alphabet.
+        // Keep these cells at their actual positions; treating STAFF as
+        // paired caption tiles would wrap it and cut its lower scanlines.
+        bool smallFont = false;
+        for (int y = 0; y < 224; y += 8)
+            for (int x = 0; x < 384; x += 8) {
+                const uint16_t code = CaptionTile(machine, x, y);
+                smallFont |= code >= 0x120 && code <= 0x15F;
+            }
+        if (smallFont) {
+            // The credits scroll by individual pixels: follow the tile
+            // grid's current sub-tile offset, not an assumed y % 8 == 0.
+            const int firstX = -((machine.cpsA[6] + Video::kFirstColumn) & 7);
+            const int firstY = -((machine.cpsA[7] + Video::kFirstLine) & 7);
+            for (int y = firstY; y < 224; y += 8)
+                for (int x = firstX; x < 384; x += 8)
+                    if (!BlankCaption(CaptionTile(machine, x, y)))
+                        CopyRect(text, out, x + 64, y, 8, 8, x + 64, y);
+            return;
+        }
+    }
+
+    const auto glyphs = Caption(machine);
+    std::vector<std::vector<Glyph>> lines(1);
+    const unsigned columns = static_cast<unsigned>(textWidth / 8);
+    for (size_t i = 0; i < glyphs.size();) {
+        while (i < glyphs.size() && glyphs[i].space) ++i;
+        const size_t start = i;
+        while (i < glyphs.size() && !glyphs[i].space) ++i;
+        const size_t length = i - start;
+        if (!length) break;
+        if (!lines.back().empty() && lines.back().size() + 1 + length > columns) lines.emplace_back();
+        if (!lines.back().empty()) lines.back().push_back({0, 0, true});
+        for (size_t n = start; n < i; ++n) {
+            if (lines.back().size() == columns) lines.emplace_back();
+            lines.back().push_back(glyphs[n]);
+        }
+    }
+    int y = fixedY >= 0 ? fixedY : 112 - (static_cast<int>(lines.size()) * 24 - 8) / 2;
+    for (const auto &line : lines) {
+        int x = centreText ? (512 - static_cast<int>(line.size()) * 8) / 2 : textX;
+        for (const auto &g : line) {
+            if (!g.space) CopyRect(text, out, g.x + 64, g.y, 8, 16, x, y);
+            x += 8;
+        }
+        y += 24;
+    }
+}
+
+void DinoStoryAfterFrame(Machine &machine) { ComicAfterFrame(machine, false); }
+void DinoEndingComicAfterFrame(Machine &machine) { ComicAfterFrame(machine, true); }
+} // namespace cps2recomp
--- a/games/dino/src/widescreen.cpp
+++ b/games/dino/src/widescreen.cpp
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Local experimental widescreen adaptation for dino (World 930201).
+// 512 columns with the board's pixel aspect ratio: 16:9, without stretching.
+// Player screen limits follow the expanded viewport; terrain collisions remain.
+#include "dino.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+namespace cps2recomp {
+bool DinoSpecialScene();
+namespace {
+using namespace dino;
+constexpr uint32_t kCamera = kVars + 0x73C;
+constexpr int kSide = Video::kWideSide;
+Machine *g_machine = nullptr;
+int g_shift = 0;
+bool g_active = false;
+bool g_fixedRoom = false;
+
+uint16_t Word(uint32_t at) {
+    const auto *p = Program(at);
+    return static_cast<uint16_t>((p[0] << 8) | p[1]);
+}
+uint32_t Long(uint32_t at) {
+    return (static_cast<uint32_t>(Word(at)) << 16) | Word(at + 2);
+}
+int Near(int residue, int target, int period) {
+    return residue + ((target - residue + period / 2) & ~(period - 1));
+}
+
+void MapTile32(int column, int row, uint16_t &code, uint16_t &attributes) {
+    column &= 63;
+    const uint32_t base = (static_cast<uint32_t>(g_machine->cpsA[3]) * 256) & 0x3C000;
+    const uint32_t index = (row & 7) + (column << 3) + ((row & 0x38) << 6);
+    const uint8_t *p = &g_machine->videoRam[base + index * 4];
+    code = static_cast<uint16_t>((p[0] << 8) | p[1]);
+    attributes = static_cast<uint16_t>((p[2] << 8) | p[3]);
+}
+
+// The original foreground streamer: 0214F0 (stage plan), 02152C (32px
+// metatile), 02142A (its four 16px tiles), 0214C0 (VRAM coordinates).
+// World Y points upward; the CPS tile-map row points downward.
+bool ForegroundTile(int x, int y, int row, uint16_t &code, uint16_t &attributes) {
+    const unsigned stage = Ram8(kStage);
+    const int columns = Ram8(kCamera + 0x40), rows = Ram8(kCamera + 0x41);
+    const uint32_t plan = Ram32(kCamera + 0x42);
+    if (stage >= kStages || columns <= 0 || rows <= 0 || plan >= 0x180000 || x < 0 || y < 0) {
+        return false;
+    }
+    // Episode 3 loops this portion of its scenery (original 021520).
+    if (stage == 2) {
+        while ((x & ~31) >= 0x4D00) {
+            x -= 0xF00;
+        }
+    }
+    if ((x >> 8) >= columns || (y >> 8) >= rows) {
+        return false;
+    }
+    const uint16_t block = Word(plan + 2u * static_cast<unsigned>((x >> 8) * rows + (y >> 8)));
+    const uint32_t cells = Long(0x02155E + stage * 4);
+    const uint16_t offset = static_cast<uint16_t>((block << 7) + ((x & 0xE0) >> 1) + 14 - ((y & 0xE0) >> 4));
+    const uint16_t cell = Word(cells + static_cast<int16_t>(offset));
+    const uint32_t quads = Long(0x021454 + stage * 4);
+    const uint32_t tile = quads + static_cast<int16_t>(static_cast<uint16_t>(cell << 4)) +
+                          static_cast<unsigned>(((x & 16) ? 2 : 0) + (row & 1)) * 4;
+    if (tile + 4 > 0x180000) {
+        return false;
+    }
+    code = Word(tile);
+    attributes = Word(tile + 2);
+    if (Ram8(kCamera + 5) == 0x0E) {
+        code = static_cast<uint16_t>(0x6F80 + (attributes >> 10));
+        attributes = 0;
+    }
+    return true;
+}
+
+bool SideTile(int which, int column, int row, int at, uint16_t &code, uint16_t &attributes) {
+    if (!g_active || !g_machine) {
+        return false;
+    }
+    if (which == 0) {
+        // Scroll 1 is the original HUD. Do not repeat its unused map at the
+        // added edges. Tile 001F is all transparent pixels in this ROM set.
+        code = 0x001F;
+        attributes = 0;
+        return true;
+    }
+    if (which == 2) {
+        const auto stage = Ram8(kStage), part = Ram8(kCamera + 0x4A);
+        {
+            // The parallax planes start at map column zero. The
+            // wide view can see one or two earlier columns even when the
+            // foreground stays inside its world: the original streamer left
+            // those wrapped columns as tile 1C00 with attribute 0000/0010.
+            // Continue the first 128px painted background bay to the left.
+            // Only map padding is replaced; black pixels in real art remain.
+            // Scroll 3 wraps every 2048px; the same leading padding is
+            // reached again when a repeating plane crosses that boundary.
+            const int planeX = (g_machine->cpsA[10] + at - g_shift) & 2047;
+            if (planeX >= 1984) {
+                MapTile32(column, row, code, attributes);
+                if (code == 0x1C00 && (attributes == 0 || attributes == 0x10)) {
+                    MapTile32(column & 3, row, code, attributes);
+                    if (code != 0x1C00 || (attributes != 0 && attributes != 0x10)) {
+                        return true;
+                    }
+                }
+            }
+        }
+        if (stage == 6 && part == 1 && at >= 384) {
+            // The mine shaft's further plane contains the mine carts and
+            // machinery behind its 16px rock/wood layer. Extend both planes
+            // from the same middle bay (screen X96..223), so transparent
+            // places in the rock layer reveal matching scenery, not a gap.
+            MapTile32(column - 9, row, code, attributes);
+            return true;
+        }
+        if (stage == 0 && part == 2) {
+            MapTile32(column, row, code, attributes);
+            if (code == 0x1C00 && attributes == 0x0010) {
+                // This city's skyline/water plane stops at 480px. Its
+                // blank-map sentinel marks missing art, not black pixels
+                // within a painting. Continue the last city/water bay with
+                // another original 32px tile from the same row.
+                for (int back = 1; back <= 8; ++back) {
+                    MapTile32(column - back, row, code, attributes);
+                    if (code != 0x1C00 || attributes != 0x0010) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+    if (which != 1) {
+        return false;
+    }
+    if (g_fixedRoom) {
+        // This room is a complete 512px map, already painted correctly in
+        // VRAM. Its foreground is positioned below from local coordinates;
+        // the scrolling-stage decoder must not apply the world's camera X.
+        return false;
+    }
+    const int cameraX = Ram16(kCamera + 8), cameraY = Ram16(kCamera + 12);
+    int x = Near(column * 16, cameraX + at - kSide - g_shift, 1024);
+    const int y = Near((0x3E0 - ((row & ~1) * 16)) & 1023, cameraY + 112, 1024);
+    // Episode 7's vertical mine shaft has a 512px plan but only 384px of
+    // painted room. Extend its rock/wood construction with an additional
+    // 128px bay built from the existing middle bay's tiles. This is authored
+    // scenery reuse, not newly recovered hidden art, mirroring or stretching.
+    if (Ram8(kStage) == 6 && Ram8(kCamera + 0x4A) == 1 && x >= 384 && x < 512) {
+        x = 96 + (x - 384);
+    }
+    return ForegroundTile(x, y, row, code, attributes);
+}
+
+int MoveObject(uint32_t, uint16_t, int) {
+    // CPS-1's object renderer subtracts this value; its scroll renderer adds
+    // wide.scroll to the screen position. Keep both transformations aligned.
+    return -g_shift;
+}
+
+void CheckPlan(Machine &machine) {
+    if (!g_active || !std::getenv("DINO_WIDE_CHECK") || machine.frame % 60 != 0) {
+        return;
+    }
+    unsigned same = 0, different = 0, missing = 0;
+    const int cameraX = Ram16(kCamera + 8), cameraY = Ram16(kCamera + 12);
+    const uint32_t base = (static_cast<uint32_t>(machine.cpsA[2]) * 256) & 0x3C000;
+    for (int sx = 96; sx < 288; sx += 16) {
+        const int column = g_fixedRoom ? (sx >> 4) : ((machine.cpsA[8] + Video::kFirstColumn + sx) >> 4) & 63;
+        const int x = g_fixedRoom ? column * 16 : Near(column * 16, cameraX + sx, 1024);
+        for (int sy = 48; sy < 192; sy += 16) {
+            const int row = ((machine.cpsA[9] + Video::kFirstLine + sy) >> 4) & 63;
+            const int y = Near((0x3E0 - ((row & ~1) * 16)) & 1023, cameraY + 112, 1024);
+            uint16_t code, attr;
+            if (!ForegroundTile(x, y, row, code, attr)) {
+                ++missing;
+                continue;
+            }
+            const uint32_t index = (row & 15) + (column << 4) + ((row & 0x30) << 6);
+            const uint8_t *p = &machine.videoRam[base + index * 4];
+            if (code == ((p[0] << 8) | p[1]) && attr == ((p[2] << 8) | p[3])) {
+                ++same;
+            } else {
+                ++different;
+            }
+        }
+    }
+    fprintf(stderr, "dino widescreen plan: frame %llu stage %u part %u camera %d,%d same %u different %u unavailable %u\n",
+            static_cast<unsigned long long>(machine.frame), Ram8(kStage), Ram8(kCamera + 0x4A), cameraX, cameraY,
+            same, different, missing);
+}
+} // namespace
+
+bool DinoStageWide(Machine &machine) {
+    g_machine = &machine;
+    g_active = FeatureOn("widescreen") && !DinoSpecialScene() && Ram8(kStep) == 0x0C && Ram8(kStage) < kStages &&
+               Ram8(kCamera + 0x40) > 0 && Ram8(kCamera + 0x41) > 0;
+    g_fixedRoom = g_active && Ram8(kStage) == 7 && Ram8(kCamera + 0x4A) == 3 &&
+                  Ram8(kCamera + 0x40) == 2 && Ram8(kCamera + 0x41) == 1;
+    if (g_active && !g_fixedRoom && Ram8(kStage) != 2 && Ram16(kCamera + 8) >= Ram8(kCamera + 0x40) * 256) {
+        g_active = false;
+    }
+    auto &wide = machine.video.wide;
+    wide = {};
+    g_shift = 0;
+    if (!g_active) {
+        return false;
+    }
+    wide.side = kSide;
+    wide.linearObjects = true;
+    if (g_fixedRoom) {
+        // The final room is not a streamed world map: its complete plan is
+        // two 256px columns. Both columns match the loaded VRAM exactly.
+        // The upstream viewer retains the preceding world's 0x1120 camera;
+        // use the room's local coordinates for this plane. Like a stage at
+        // its left boundary, actors keep their original screen X and the
+        // extra 128px continues the room to the right; the HUD stays centered.
+        g_shift = -kSide;
+        wide.scroll[1] = machine.cpsA[8] & 1023;
+        wide.scroll[2] = g_shift;
+        wide.object = MoveObject;
+        wide.tile = SideTile;
+        return true;
+    }
+    const int cameraX = Ram16(kCamera + 8);
+    int stageWidth = Ram8(kCamera + 0x40) * 256;
+    if (Ram8(kStage) == 0 && Ram8(kCamera + 0x4A) == 1) {
+        // The manor painting ends after the room's final camera position
+        // (0x210) plus the original viewport. The allocation is padded to
+        // 1024px, and that padding is not additional scenery.
+        stageWidth = std::min(stageWidth, 0x210 + Video::kWidth);
+    }
+    if (Ram8(kStage) == 6) {
+        // The library and its following room have padded 256px plan blocks.
+        // Their last painted column is the native final camera plus 384px,
+        // not the end of that allocation. Keep the wide view inside the art,
+        // retaining the exact same transform for sprites and player bounds.
+        const unsigned part = Ram8(kCamera + 0x4A);
+        if (part == 2) stageWidth = std::min(stageWidth, 0x6F0 + Video::kWidth);
+        if (part == 3) stageWidth = std::min(stageWidth, 0x4F0 + Video::kWidth);
+    }
+    // The native camera RAM can be one update ahead of the scroll register.
+    // At a map boundary use the camera actually being drawn, otherwise that
+    // small difference exposes padding. Vehicle row scrolling keeps its
+    // existing transform; its per-line scroll data is not a single camera.
+    const int drawnCameraX = Ram8(kStage) == 2 ? cameraX :
+        Near((machine.cpsA[8] + Video::kFirstColumn) & 1023, cameraX, 1024);
+    const int viewLeft = std::clamp(drawnCameraX - kSide, 0, std::max(0, stageWidth - Video::kWidth - 2 * kSide));
+    g_shift = std::clamp(drawnCameraX - kSide - viewLeft, -kSide, kSide);
+    wide.scroll[1] = wide.scroll[2] = g_shift;
+    wide.object = MoveObject;
+    wide.tile = SideTile;
+    // No mirroring, cropping or scaling. SideTile documents the mine-shaft
+    // extension, which reuses the room's original tiles as additional scenery.
+    return true;
+}
+
+void DinoSpecialWide(Machine &machine);
+void DinoWideBeforeFrame(Machine &machine) {
+    if (!DinoStageWide(machine)) {
+        DinoSpecialWide(machine);
+    }
+}
+
+void DinoWideAfterFrame(Machine &machine) {
+    CheckPlan(machine);
+}
+
+bool DinoWidePlayerBounds(bool local, int &left, int &right) {
+    if (!g_active || !FeatureOn("widescreen")) {
+        return false;
+    }
+    // The same offset as MoveObject: screen X = world X - camera X +
+    // kSide + g_shift. Keep the original 16px foot-position inset at the
+    // actual picture edges, including the asymmetric stage-end viewports.
+    const int origin = (local ? 0 : Ram16(kCamera + 8)) - kSide - g_shift;
+    left = origin + 16;
+    right = origin + Video::kWidth + 2 * kSide - 16;
+    return true;
+}
+
+
+void RegisterDinoWide() {
+    // The camera can move during this frame, after beforeFrame configured
+    // the wide view. Refresh its transform after the native X streamer, in
+    // the same blanking interval as the camera update, before visible lines
+    // are drawn. This avoids 2px gaps on a return to the left stage boundary
+    // without replacing any raster rows or repainting a finished picture.
+    AddHook(0x021284,"WideCameraTransform",[](M68K &c) {
+        if (g_active && (c.a[6]&0xFFFFFF)==kCamera) {
+            DinoStageWide(static_cast<Machine &>(c.bus));
+        }
+        return false;
+    });
+    TheGame().features.push_back({"widescreen", "Display", "Widescreen 16:9",
+        "Shows additional scenery in 16:9 without stretching. Player movement follows the wider screen. "
+        "Additional scenery is reconstructed or extended using the game's original tiles.", 0});
+    TheGame().widestPicture = [] { return FeatureOn("widescreen") ? Video::kWidth + 2 * kSide : Video::kWidth; };
+}
+} // namespace cps2recomp
