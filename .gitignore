# Publish only reviewed kit files. All local ROMs, tools and builds stay ignored.
/*
!/.gitignore
!/.gitattributes
!/VERSION
!/LICENSE
!/README.md
!/NOTICE.md
!/CHANGELOG.md
!/build.py
!/sources.lock.json
!/rom-manifest.json
!/publish-manifest.json
!/patches/
/patches/*
!/patches/port.patch
!/scripts/
/scripts/*
!/scripts/audit_public.py
!/scripts/run-bazzite.sh
!/tests/
/tests/*
!/tests/test_kit.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/audit.yml
